---
import { LanguageSelector } from '../components/LanguageSelector';

const base = import.meta.env.BASE_URL;
const toHome = (hash: string) => `${base}#${hash}`;

interface Link {
  key: string;
  href: string;
}
---

<footer class="mt-16 bg-[#fdfdfe]">
  <div class="mt-12 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-4">
    <div class="border-t border-gray-200 pt-12">
      <div class="mx-6 grid grid-cols-1 sm:grid-cols-3 md:grid-cols-4">
      <div class="flex md:justify-center">
        <nav aria-labelledby="ft-product" class="flex flex-col gap-2">
          <p id="ft-product" class="text-xs font-semibold uppercase tracking-wider text-gray-400" data-i18n="footer.productTitle"></p>
          <a class="text-sm text-gray-600 transition-colors hover:text-gray-900" href={toHome('savings')} data-i18n="footer.product.savings"></a>
          <a class="text-sm text-gray-600 transition-colors hover:text-gray-900" href={toHome('retirement')} data-i18n="footer.product.retirement"></a>
          <a class="text-sm text-gray-600 transition-colors hover:text-gray-900" href={toHome('affordability')} data-i18n="footer.product.home"></a>
          <a class="text-sm text-gray-600 transition-colors hover:text-gray-900" href={toHome('investments')} data-i18n="footer.product.finances"></a>
        </nav>
      </div>

      <div class="flex md:justify-center">
        <nav aria-labelledby="ft-resources" class="flex flex-col gap-2 pt-10 sm:pt-0">
          <p id="ft-resources" class="text-xs font-semibold uppercase tracking-wider text-gray-400" data-i18n="footer.resourcesTitle"></p>
          <a class="text-sm text-gray-600 transition-colors hover:text-gray-900" href={`${base}/guia`} data-i18n="footer.resources.guide"></a>
          <a class="text-sm text-gray-600 transition-colors hover:text-gray-900" href={`${base}/faq`} data-i18n="footer.resources.faq"></a>
          <a class="text-sm text-gray-600 transition-colors hover:text-gray-900" href={`${base}/bancos`} data-i18n="footer.resources.banks"></a>
        </nav>
      </div>

      <div class="flex md:justify-center">
        <nav aria-labelledby="ft-legal" class="flex flex-col gap-2 pt-10 sm:pt-0">
          <p id="ft-legal" class="text-xs font-semibold uppercase tracking-wider text-gray-400" data-i18n="footer.legalTitle"></p>
          <a class="text-sm text-gray-600 transition-colors hover:text-gray-900" href={`${base}/privacidad`} data-i18n="footer.legal.privacy"></a>
          <a class="text-sm text-gray-600 transition-colors hover:text-gray-900" href={`${base}/terminos`} data-i18n="footer.legal.terms"></a>
        </nav>
      </div>

      <div class="pt-10 md:pt-0 flex md:justify-center">
        <LanguageSelector client:load />
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center gap-1 pt-6 text-center">
        <p class="text-xs text-gray-500">
          <svg class="inline-block w-3.5 h-3.5 text-gray-400 align-[-2px] mr-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span data-i18n="footer.dataPrivacy"></span>
        </p>
        <p class="mx-auto mt-1 max-w-3xl text-xs leading-relaxed text-gray-500">
          <svg class="inline-block w-3.5 h-3.5 text-gray-400 align-[-2px] mr-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
          <span data-i18n="footer.spainDisclaimer"></span>
        </p>
        <p class="mt-1 text-xs text-gray-500 mt-6"><span data-i18n="footer.copyright"></span></p>
      </div>
    </div>
  </div>
</footer>

<script>
  import { applyStaticI18n, LANG_CHANGED_EVENT } from '../lib/i18n';
  applyStaticI18n();
  window.addEventListener(LANG_CHANGED_EVENT, applyStaticI18n);
</script>