---
import SimplePage from '../layouts/SimplePage.astro';

const base = import.meta.env.BASE_URL;
---

<SimplePage
  dataTitle="page.privacidad.title"
  dataDescription="page.privacidad.metaDescription"
  description="Política de privacidad de NestEgg: tus datos se procesan y almacenan localmente en tu navegador."
>
  <header class="px-3 sm:px-4 lg:px-8 pt-4 sm:pt-5 lg:pt-6">
    <div class="mx-auto max-w-6xl">
      <a href={base} class="py-1 inline-flex items-center gap-1.5 text-sm font-semibold text-gray-600 transition-colors hover:text-gray-900">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        <span data-i18n="page.backHome"></span>
      </a>
    </div>
  </header>

  <div class="px-8 py-10 sm:py-14">
    <div class="mx-auto max-w-4xl">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight" data-i18n="page.privacidad.title"></h1>
      <p class="mt-2 text-sm text-gray-500" data-i18n="page.privacidad.subtitle"></p>
      <p class="mt-6 text-sm text-gray-400">Clara Jiménez Recio</p>
      <p class="text-sm text-gray-400">clarajimenezrecio@gmail.com</p>
      <p class="mt-6 leading-relaxed text-gray-500" data-i18n="page.privacidad.intro"></p>

      <div class="mt-10 flex flex-col gap-6">
        <section class="bg-[#fdfdfe] border border-gray-200 rounded-2xl p-5 sm:p-6">
          <h2 class="text-lg font-bold text-gray-900 tracking-tight" data-i18n="page.privacidad.s1Title"></h2>
          <p class="mt-3 leading-relaxed text-gray-500" data-i18n="page.privacidad.s1Body"></p>
        </section>
        <section class="bg-[#fdfdfe] border border-gray-200 rounded-2xl p-5 sm:p-6">
          <h2 class="text-lg font-bold text-gray-900 tracking-tight" data-i18n="page.privacidad.s2Title"></h2>
          <p class="mt-3 leading-relaxed text-gray-500" data-i18n="page.privacidad.s2Body"></p>
        </section>
        <section class="bg-[#fdfdfe] border border-gray-200 rounded-2xl p-5 sm:p-6">
          <h2 class="text-lg font-bold text-gray-900 tracking-tight" data-i18n="page.privacidad.s3Title"></h2>
          <p class="mt-3 leading-relaxed text-gray-500" data-i18n="page.privacidad.s3Body"></p>
        </section>
        <section class="bg-[#fdfdfe] border border-gray-200 rounded-2xl p-5 sm:p-6">
          <h2 class="text-lg font-bold text-gray-900 tracking-tight" data-i18n="page.privacidad.s4Title"></h2>
          <p class="mt-3 leading-relaxed text-gray-500" data-i18n="page.privacidad.s4Body"></p>
        </section>
        <section class="bg-[#fdfdfe] border border-gray-200 rounded-2xl p-5 sm:p-6">
          <h2 class="text-lg font-bold text-gray-900 tracking-tight" data-i18n="page.privacidad.s5Title"></h2>
          <p class="mt-3 leading-relaxed text-gray-500" data-i18n="page.privacidad.s5Body"></p>
        </section>
      </div>
    </div>
  </div>
</SimplePage>