---
import SimplePage from '../layouts/SimplePage.astro';
import { BankLogo, Icon, Tooltip } from '../components/common';
import { BANKS } from '../lib/bankImports';

const base = import.meta.env.BASE_URL;
const banks = [...BANKS].sort((a, b) => a.label.localeCompare(b.label));
---

<SimplePage
  dataTitle="page.bancos.title"
  dataDescription="page.bancos.metaDescription"
  description="Bancos compatibles con el agregador de finanzas de NestEgg: Trade Republic, MyInvestor, CaixaBank, Santander, PayPal y Revolut."
>
  <header class="px-8 pt-4 sm:pt-5 lg:pt-6">
    <div class="mx-auto max-w-6xl">
      <a href={base} class="inline-flex items-center gap-1.5 text-sm font-semibold text-gray-600 transition-colors hover:text-gray-900">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        <span data-i18n="page.backHome"></span>
      </a>
    </div>
  </header>

  <div class="px-8 py-10 sm:py-14">
    <div class="mx-auto max-w-4xl">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight" data-i18n="page.bancos.title"></h1>
      <p class="mt-3 leading-relaxed text-gray-500" data-i18n="page.bancos.subtitle"></p>
      <p class="mt-4 leading-relaxed text-gray-500" data-i18n="page.bancos.intro"></p>

      <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {banks.map(bank => (
          <div class="bg-[#fdfdfe] border border-gray-200 rounded-xl p-3 flex items-center justify-between gap-3">
            <div class="flex items-center gap-2">
              <BankLogo bank={bank.id} size={16} />
              <p class="text-xs font-semibold text-gray-600 uppercase tracking-widest">{bank.label}</p>
              {bank.id === 'myinvestor' && (
                <p><Tooltip client:load textKey="page.bancos.bank.myinvestor.hint"><Icon name="info" className="h-3.5 w-3.5 text-gray-400" /></Tooltip></p>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</SimplePage>