---
import SavingsSimulator from '../components/SavingsSimulator';
import RetirementSimulator from '../components/RetirementSimulator';
import AffordabilitySimulator from '../components/AffordabilitySimulator';
import InvestmentsSimulator from '../components/InvestmentsSimulator';
import BackupRestore from '../components/BackupRestore';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

const title = 'NestEgg';
const description = 'Analiza tus movimientos bancarios, simula tus ahorros e inversiones, descubre qué casa puedes permitirte y planifica tu jubilación.';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="title" content={title} />
    <meta name="description" content={description} data-i18n-meta="home.metaDescription" />
    <meta name="viewport" content="width=device-width" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://clara-jr.github.io/nestegg/" />
    <meta property="og:site_name" content="NestEgg" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content="https://clara-jr.github.io/nestegg/thumbnail.png" />
    <meta property="og:image:width" content="395" />
    <meta property="og:image:height" content="289" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="NestEgg — simuladores de finanzas personales" data-i18n-meta="home.imageAlt" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:site" content="@clear_is_me" />
    <meta property="twitter:creator" content="@clear_is_me" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://clara-jr.github.io/nestegg/thumbnail.png" />
    <meta property="twitter:image:alt" content="NestEgg — simuladores de finanzas personales" data-i18n-meta="home.imageAlt" />
    <link rel="icon" type="image/svg+xml" href="/nestegg/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Signika:wght@400;500;600;700&display=swap"
    />
  </head>
  <body class="bg-[#fdfdfe] min-h-screen">
    <header class="px-3 sm:px-4 lg:px-8 pt-4 sm:pt-5 lg:pt-6">
      <div class="relative mx-auto max-w-6xl w-full" id="nav-container">
        <div class="flex items-center justify-between gap-3">
          <button
            id="header-home-btn"
            data-tab="home"
            class="tab-btn cursor-pointer flex items-center gap-2.5 rounded-xl px-1.5 py-1 text-gray-900 transition-all"
            aria-label="NestEgg - pantalla principal"
            data-i18n-aria="home.homeAria"
          >
            <span class="flex-shrink-0 w-6 h-6 text-gray-900">
              <svg class="w-full h-full" viewBox="0 0 24 24" aria-hidden="true">
                <g fill="currentColor">
                  <path
                    d="M7.038 18.963Q5 16.925 5 14q0-1.925.638-3.875t1.65-3.537T9.55 4T12 3q1.225 0 2.463 1t2.25 2.588t1.65 3.537T19 14q0 2.925-2.037 4.963T12 21t-4.962-2.037m8.5-1.426Q17 16.075 17 14q0-1.425-.488-3t-1.225-2.912t-1.612-2.213T12.013 5t-1.675.875t-1.625 2.213T7.488 11T7 14q0 2.075 1.463 3.538T12 19t3.538-1.463M13 18q.425 0 .713-.288T14 17t-.288-.712T13 16q-1.25 0-2.125-.875T10 13q0-.425-.288-.712T9 12t-.712.288T8 13q0 2.075 1.463 3.538T13 18m-1-6"
                  />
                </g>
              </svg>
            </span>
            <span class="text-sm font-semibold tracking-tight">NestEgg</span>
          </button>

          <!-- Desktop nav -->
          <nav id="desktop-nav" class="hidden md:flex items-center gap-1.5" aria-label="Simuladores y calculadoras" data-i18n-aria="home.navAria">
            <button class="tab-btn cursor-pointer flex items-center gap-2 rounded-xl px-3.5 py-2.5 text-sm font-semibold text-gray-600 transition-all hover:bg-zinc-100 hover:text-gray-900" data-tab="savings">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/></svg>
              <span data-i18n="home.navSavings"></span>
            </button>
            <button class="tab-btn cursor-pointer flex items-center gap-2 rounded-xl px-3.5 py-2.5 text-sm font-semibold text-gray-600 transition-all hover:bg-zinc-100 hover:text-gray-900" data-tab="retirement">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <span data-i18n="home.navRetirement"></span>
            </button>
            <button class="tab-btn cursor-pointer flex items-center gap-2 rounded-xl px-3.5 py-2.5 text-sm font-semibold text-gray-600 transition-all hover:bg-zinc-100 hover:text-gray-900" data-tab="affordability">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              <span data-i18n="home.navHome"></span>
            </button>
            <button class="tab-btn cursor-pointer flex items-center gap-2 rounded-xl px-3.5 py-2.5 text-sm font-semibold text-gray-600 transition-all hover:bg-zinc-100 hover:text-gray-900" data-tab="investments">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
              <span data-i18n="home.navFinances"></span>
            </button>
          </nav>

          <!-- Mobile trigger -->
          <button
            id="nav-mobile-trigger"
            class="md:hidden cursor-pointer flex items-center justify-center w-11 h-11 rounded-xl border border-gray-200 bg-[#fdfdfe] text-gray-900 transition-colors hover:bg-zinc-100"
            aria-label="Abrir menú de simuladores"
            data-i18n-aria="home.menuAria"
            aria-expanded="false"
            aria-controls="nav-mobile-menu"
          >
            <svg id="nav-mobile-open-icon" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
            <svg id="nav-mobile-close-icon" class="hidden w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>

        <!-- Mobile dropdown -->
        <div id="nav-mobile-menu" class="hidden md:hidden absolute left-0 right-0 top-full mt-2 bg-[#fdfdfe] border border-gray-200 rounded-xl shadow-lg overflow-hidden z-50">
          <button class="tab-btn cursor-pointer flex items-center gap-3 w-full px-5 py-3.5 text-sm font-semibold text-gray-600 text-left transition-colors hover:bg-zinc-100 hover:text-gray-900" data-tab="savings">
            <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/></svg>
            <span data-i18n="home.menuSavings"></span>
          </button>
          <div class="border-t border-gray-100"></div>
          <button class="tab-btn cursor-pointer flex items-center gap-3 w-full px-5 py-3.5 text-sm font-semibold text-gray-600 text-left transition-colors hover:bg-zinc-100 hover:text-gray-900" data-tab="retirement">
            <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span data-i18n="home.menuRetirement"></span>
          </button>
          <div class="border-t border-gray-100"></div>
          <button class="tab-btn cursor-pointer flex items-center gap-3 w-full px-5 py-3.5 text-sm font-semibold text-gray-600 text-left transition-colors hover:bg-zinc-100 hover:text-gray-900" data-tab="affordability">
            <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span data-i18n="home.menuHome"></span>
          </button>
          <div class="border-t border-gray-100"></div>
          <button class="tab-btn cursor-pointer flex items-center gap-3 w-full px-5 py-3.5 text-sm font-semibold text-gray-600 text-left transition-colors hover:bg-zinc-100 hover:text-gray-900" data-tab="investments">
            <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
            <span data-i18n="home.menuFinances"></span>
          </button>
        </div>
      </div>
    </header>
    <div id="tab-home" class="tab-content hidden">
      <div class="py-6 px-8 mb-4 sm:px-8">
        <div class="mx-auto max-w-6xl">
          <div class="flex flex-col gap-14 md:gap-20">
            <section class="text-center px-2 pt-8 sm:pt-14 pb-4">
              <span class="inline-flex items-center gap-2 rounded-2xl border border-gray-200 bg-[#fdfdfe] px-3.5 py-3 text-xs sm:text-sm font-semibold text-gray-600">
                <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" aria-hidden="true"><path d="m9 11l3 3l8-8"/><path d="M20 12a8 8 0 1 1-5.3-7.533"/></svg>
                <span class="max-[460px]:hidden" data-i18n="home.badge"></span>
                <span class="min-[460px]:hidden flex flex-col items-center leading-tight">
                  <span data-i18n="home.badge1"></span>
                  <span class="mt-1" data-i18n="home.badge2"></span>
                </span>
              </span>
              <p class="mx-auto mt-12 max-w-2xl text-base sm:text-xl leading-relaxed text-gray-500" data-i18n="home.heroText"></p>
              <button
                data-scroll="#simuladores"
                class="home-scroll cursor-pointer mt-12 inline-flex items-center gap-2 rounded-xl bg-gray-900 px-6 py-3 text-base font-semibold text-white shadow-sm transition-all hover:bg-gray-800"
              >
                <span data-i18n="home.explore"></span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7-7-7M12 21V3" /></svg>
              </button>
            </section>

            <section aria-label="Vistas previas de los simuladores" data-i18n-aria="home.previewAria" class="flex flex-col">
                <div class="text-center">
                  <p class="text-xs font-semibold uppercase tracking-widest text-gray-600" data-i18n="home.previewQuestion"></p>
                  <h2 class="mt-2 text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight" data-i18n="home.previewTitle"></h2>
                  <p class="mx-auto mt-2 max-w-xl leading-relaxed text-gray-500" data-i18n="home.previewSubtitle"></p>
                </div>

              <div class="mt-6 flex items-center justify-center gap-3 max-[509px]:-ml-6 max-[509px]:-mr-6">
                <button
                  data-preview-nav="prev"
                  aria-label="Anterior vista previa"
                  data-i18n-aria="home.previewPrev"
                  class="hidden min-[640px]:flex cursor-pointer flex-shrink-0 items-center justify-center w-11 h-11 rounded-xl border border-gray-200 bg-[#fdfdfe] text-gray-700 transition-colors hover:bg-zinc-100 hover:text-gray-900"
                >
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <div class="relative min-w-0 w-full max-w-[360px] max-[509px]:max-w-none min-[509px]:max-w-[430px] min-[921px]:max-w-[876px]">
                <div id="preview-track" class="no-scrollbar flex w-full gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth">
                <div class="snap-start flex-shrink-0 w-[360px] max-[509px]:w-full min-[509px]:w-[430px] min-[921px]:w-[calc(50%-8px)] bg-[#fdfdfe] border border-gray-200 rounded-2xl p-5 sm:p-6 flex flex-col">
                  <p class="text-xs font-semibold uppercase tracking-widest text-gray-400" data-i18n="home.preview.savingsLabel"></p>
                  <h3 class="mt-1.5 text-lg font-bold text-gray-900 tracking-tight" data-i18n="home.preview.savingsTitle"></h3>
                  <div class="mt-4 border-t border-gray-200 pt-4">
                    <div class="grid grid-cols-1 gap-3">
                      <div class="bg-[#fdfdfe] border border-gray-200 rounded-xl p-4 flex items-center justify-between gap-3">
                        <div class="flex items-center gap-2">
                          <svg class="w-6 h-6 text-gray-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/></svg>
                          <p class="text-xs font-semibold text-gray-600 uppercase tracking-wider" data-i18n="home.preview.totalSaved"></p>
                        </div>
                        <p class="text-xl font-bold text-gray-900">250.000 €</p>
                      </div>
                      <div class="bg-[#fdfdfe] border border-gray-200 rounded-xl p-4 flex items-center justify-between gap-3">
                        <div class="flex items-center gap-2">
                          <svg class="w-6 h-6 text-gray-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" x2="21" y1="22" y2="22"/><line x1="6" x2="6" y1="18" y2="11"/><line x1="10" x2="10" y1="18" y2="11"/><line x1="14" x2="14" y1="18" y2="11"/><line x1="18" x2="18" y1="18" y2="11"/><polygon points="12 2 20 7 4 7"/></svg>
                          <p class="text-xs font-semibold text-gray-600 uppercase tracking-wider" data-i18n="home.preview.remunerated"></p>
                        </div>
                        <p class="text-xl font-bold text-gray-900">50.000 €</p>
                      </div>
                      <div class="bg-[#fdfdfe] border border-gray-200 rounded-xl p-4 flex items-center justify-between gap-3">
                        <div class="flex items-center gap-2">
                          <svg class="w-6 h-6 text-gray-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
                          <p class="text-xs font-semibold text-gray-600 uppercase tracking-wider" data-i18n="home.preview.investments"></p>
                        </div>
                        <p class="text-xl font-bold text-gray-900">200.000 €</p>
                      </div>
                    </div>
                    <div class="mt-5 border-t border-gray-200 pt-5">
                      <p class="text-xs font-bold text-gray-900 uppercase tracking-wider mb-4" data-i18n="home.preview.contributedVsTotal"></p>
                      <svg class="w-full" viewBox="0 0 340 170" fill="none" role="img" aria-label="Gráfica del dinero aportado y el total invertido a lo largo de 30 años" data-i18n-aria="home.preview.chartAria">
                        <line x1="4" y1="150" x2="340" y2="150" stroke="#d1d5db" stroke-width="1" />
                        <line x1="4" y1="121.6" x2="336" y2="121.6" stroke="#e5e7eb" stroke-width="1" stroke-dasharray="3 3" />
                        <line x1="4" y1="93.2" x2="336" y2="93.2" stroke="#e5e7eb" stroke-width="1" stroke-dasharray="3 3" />
                        <line x1="4" y1="64.8" x2="336" y2="64.8" stroke="#e5e7eb" stroke-width="1" stroke-dasharray="3 3" />
                        <line x1="4" y1="36.4" x2="336" y2="36.4" stroke="#e5e7eb" stroke-width="1" stroke-dasharray="3 3" />
                        <line x1="4" y1="8" x2="336" y2="8" stroke="#e5e7eb" stroke-width="1" stroke-dasharray="3 3" />
                        <text x="336" y="125.6" text-anchor="end" font-size="9" fill="#706f6c">50k €</text>
                        <text x="336" y="97.2" text-anchor="end" font-size="9" fill="#706f6c">100k €</text>
                        <text x="336" y="68.8" text-anchor="end" font-size="9" fill="#706f6c">150k €</text>
                        <text x="336" y="40.4" text-anchor="end" font-size="9" fill="#706f6c">200k €</text>
                        <text x="336" y="11.6" text-anchor="end" font-size="9" fill="#706f6c">250k €</text>
                        <path d="M4 124.4 L336 87.5" stroke="#706f6c" stroke-width="2" stroke-linecap="round" />
                        <path d="M4 124.4 C22.4 121.6 40.8 119.2 59.3 116 C77.8 112.8 96.2 109 114.7 104.7 C133.1 100.4 151.6 95.4 170 89.7 C188.4 84 206.9 77.4 225.3 69.8 C243.8 62.2 262.2 53.4 280.7 43.3 C299.1 33.2 317.6 19.8 336 8" stroke="#00bc7d" stroke-width="2" stroke-linecap="round" />
                      </svg>
                      <div class="grid grid-cols-3 text-xs text-gray-500">
                        <span class="text-right" data-i18n="home.preview.axis10"></span><span class="text-right" data-i18n="home.preview.axis20"></span><span class="text-right" data-i18n="home.preview.axis30"></span>
                      </div>
                      <div class="mt-4 flex items-center justify-center gap-4 text-xs text-gray-700">
                        <span class="inline-flex items-center gap-1.5"><span class="w-4 h-0.5 rounded-full bg-[#706f6c]"></span><span data-i18n="home.preview.contributed"></span></span>
                        <span class="inline-flex items-center gap-1.5"><span class="w-4 h-0.5 rounded-full bg-[#00bc7d]"></span><span data-i18n="home.preview.total"></span></span>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="snap-start flex-shrink-0 w-[360px] max-[509px]:w-full min-[509px]:w-[430px] min-[921px]:w-[calc(50%-8px)] bg-[#fdfdfe] border border-gray-200 rounded-2xl p-5 sm:p-6 flex flex-col">
                  <p class="text-xs font-semibold uppercase tracking-widest text-gray-400" data-i18n="home.preview.retirementLabel"></p>
                  <h3 class="mt-1.5 text-lg font-bold text-gray-900 tracking-tight" data-i18n="home.preview.retirementTitle"></h3>
                  <div class="mt-4 border-t border-gray-200 pt-4">
                    <div class="rounded-2xl border border-gray-200">
                      <div class="rounded-t-2xl border-b border-gray-200 bg-zinc-50 px-5 py-4.5">
                        <p class="text-sm font-bold text-gray-900" data-i18n="home.preview.withPension" data-i18n-vars="{&quot;amount&quot;:&quot;2.150 €&quot;}"></p>
                      </div>
                      <div class="grid grid-cols-1 divide-y divide-gray-200">
                        <div class="px-4 py-4">
                          <div class="flex items-center gap-2 mb-2">
                            <svg class="w-5 h-5 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            <p class="text-xs font-semibold text-gray-600 uppercase tracking-wider" data-i18n="home.preview.minAge"></p>
                          </div>
                          <p class="text-xl font-bold text-gray-900" data-i18n="home.preview.minAgeValue1"></p>
                        </div>
                        <div class="px-4 py-4">
                          <div class="flex items-center gap-2 mb-2">
                            <svg class="w-5 h-5 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/></svg>
                            <p class="text-xs font-semibold text-gray-600 uppercase tracking-wider" data-i18n="home.preview.savingsNeededAt" data-i18n-vars="{&quot;age&quot;:&quot;64&quot;}"></p>
                          </div>
                          <p class="text-xl font-bold text-gray-900">150.000 €</p>
                        </div>
                      </div>
                    </div>
