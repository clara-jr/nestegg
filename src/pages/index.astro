    </div>
    <div id="tab-affordability" class="tab-content hidden">
      <AffordabilitySimulator client:load />
    </div>
    <div id="tab-investments" class="tab-content hidden">
      <InvestmentsSimulator client:load />
    </div>
    <BackupRestore client:load />
    <script>
      const contents = {
        home: document.getElementById('tab-home'),
        savings: document.getElementById('tab-savings'),
        retirement: document.getElementById('tab-retirement'),
        affordability: document.getElementById('tab-affordability'),
        investments: document.getElementById('tab-investments'),
      };
      const tabBtns = document.querySelectorAll('.tab-btn');
      const mobileTrigger = document.getElementById('nav-mobile-trigger');
      const mobileMenu = document.getElementById('nav-mobile-menu')!;
      const mobileOpenIcon = document.getElementById('nav-mobile-open-icon');
      const mobileCloseIcon = document.getElementById('nav-mobile-close-icon');
      let mobileOpen = false;

      function setMobileMenu(open: boolean) {
        mobileOpen = open;
        mobileMenu.classList.toggle('hidden', !open);
        mobileOpenIcon?.classList.toggle('hidden', open);
        mobileCloseIcon?.classList.toggle('hidden', !open);
        mobileTrigger?.setAttribute('aria-expanded', String(open));
      }

      function closeMobile() {
        setMobileMenu(false);
      }

      function switchTab(tab: string, scrollToTop = false) {
        localStorage.setItem('nestegg-tab', tab);
        tabBtns.forEach(btn => {
          const isActive = (btn as HTMLElement).dataset.tab === tab;
          if (btn.closest('#nav-mobile-menu')) {
            btn.classList.toggle('bg-zinc-100', isActive);
            btn.classList.toggle('text-gray-900', isActive);
            btn.classList.toggle('text-gray-600', !isActive);
          } else if ((btn as HTMLElement).dataset.tab === 'home') {
            btn.classList.toggle('text-gray-900', true);
          } else {
            btn.classList.toggle('bg-zinc-100', isActive);
            btn.classList.toggle('text-gray-900', isActive);
            btn.classList.toggle('text-gray-600', !isActive);
          }
        });
        Object.entries(contents).forEach(([key, el]) => {
          el?.classList.toggle('hidden', key !== tab);
        });
        window.dispatchEvent(new CustomEvent('nestegg-tab-changed', { detail: { tab } }));
        closeMobile();
        if (scrollToTop) window.scrollTo(0, 0);
      }

      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          history.replaceState(null, '', window.location.pathname + window.location.search);
          switchTab((btn as HTMLElement).dataset.tab ?? '', true);
        });
      });

      document.querySelectorAll('.home-tab').forEach(btn => {
        btn.addEventListener('click', () => {
          history.replaceState(null, '', window.location.pathname + window.location.search);
          switchTab((btn as HTMLElement).dataset.tab ?? 'home', true);
        });
      });

      document.querySelectorAll('.home-scroll').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelector((btn as HTMLElement).dataset.scroll ?? '')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      if (mobileTrigger) {
        mobileTrigger.addEventListener('click', (e) => {
          e.stopPropagation();
          setMobileMenu(!mobileOpen);
        });
        document.addEventListener('click', (e) => {
          if (!document.getElementById('nav-container')?.contains(e.target as Node)) {
            closeMobile();
          }
        });
      }

      const savedTab =
        (window.location.hash && contents[window.location.hash.slice(1)]) ?
          window.location.hash.slice(1) :
          (localStorage.getItem('nestegg-tab') || 'home');
      switchTab(savedTab);

      window.addEventListener('hashchange', () => {
        const tab = window.location.hash.slice(1);
        if (contents[tab]) switchTab(tab, true);
      });

      const previewTrack = document.getElementById('preview-track');
      const previewDots = document.querySelectorAll('.preview-dot');
      const previewNavBtns = document.querySelectorAll('[data-preview-nav]');
      if (previewTrack) {
        const previewStep = () => {
          const first = previewTrack.firstElementChild as HTMLElement | null;
          return (first?.offsetWidth ?? 0) + 16;
        };
        const maxPreviewScroll = () => previewTrack.scrollWidth - previewTrack.clientWidth;
        previewNavBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const isPrev = (btn as HTMLElement).dataset.previewNav === 'prev';
            const step = previewStep();
            const maxScroll = maxPreviewScroll();
            if (maxScroll <= 0) return;
            const index = Math.round(previewTrack.scrollLeft / step);
            let target: number;
            if (isPrev) {
              target = previewTrack.scrollLeft <= 1 ? maxScroll : Math.max(0, (index - 1) * step);
            } else {
              target = previewTrack.scrollLeft >= maxScroll - 1 ? 0 : Math.min(maxScroll, (index + 1) * step);
            }
            previewTrack.scrollTo({ left: target, behavior: 'smooth' });
          });
        });
        const updatePreviewDots = () => {
          const index = Math.min(previewDots.length - 1, Math.round(previewTrack.scrollLeft / previewStep()));
          previewDots.forEach((dot, i) => {
            dot.classList.toggle('bg-gray-900', i === index);
            dot.classList.toggle('bg-gray-300', i !== index);
          });
        };
        const updatePreviewNav = () => {
          updatePreviewDots();
        };
        previewTrack.addEventListener('scroll', updatePreviewNav);
        previewDots.forEach((dot, i) => {
          (dot as HTMLElement).addEventListener('click', () => {
            previewTrack.scrollTo({ left: i * previewStep(), behavior: 'smooth' });
          });
        });
        updatePreviewNav();
      }
    </script>
    <SiteFooter />
