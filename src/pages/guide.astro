---
import SimplePage from '../layouts/SimplePage.astro';
import { Icon } from '../components/common';

const base = import.meta.env.BASE_URL;

interface GuideSection {
  titleKey: string;
  textKey: string;
  icon: string;
  stepKeys: string[];
}

const sections: GuideSection[] = [
  { titleKey: 'page.guide.savingsTitle', textKey: 'page.guide.savingsText', icon: 'wallet', stepKeys: ['page.guide.savingsStep1', 'page.guide.savingsStep2', 'page.guide.savingsStep3', 'page.guide.savingsStep4', 'page.guide.savingsStep5'] },
  { titleKey: 'page.guide.retirementTitle', textKey: 'page.guide.retirementText', icon: 'calendar', stepKeys: ['page.guide.retirementStep1', 'page.guide.retirementStep2', 'page.guide.retirementStep3', 'page.guide.retirementStep4', 'page.guide.retirementStep5'] },
  { titleKey: 'page.guide.homeTitle', textKey: 'page.guide.homeText', icon: 'home', stepKeys: ['page.guide.homeStep1', 'page.guide.homeStep2', 'page.guide.homeStep3', 'page.guide.homeStep4', 'page.guide.homeStep5'] },
  { titleKey: 'page.guide.financesTitle', textKey: 'page.guide.financesText', icon: 'trendingUp', stepKeys: ['page.guide.financesStep1', 'page.guide.financesStep2', 'page.guide.financesStep3', 'page.guide.financesStep4', 'page.guide.financesStep5', 'page.guide.financesStep6'] },
  { titleKey: 'page.guide.profilesTitle', textKey: 'page.guide.profilesText', icon: 'users', stepKeys: ['page.guide.profilesStep1', 'page.guide.profilesStep2', 'page.guide.profilesStep3', 'page.guide.profilesStep4', 'page.guide.profilesStep5'] },
  { titleKey: 'page.guide.backupTitle', textKey: 'page.guide.backupText', icon: 'floppy', stepKeys: ['page.guide.backupStep1', 'page.guide.backupStep2', 'page.guide.backupStep3', 'page.guide.backupStep4', 'page.guide.backupStep5'] },
];
---

<SimplePage
  dataTitle="page.guide.title"
  dataDescription="page.guide.metaDescription"
  description="Guía de uso de NestEgg: simulador de ahorros, calculadora de jubilación, calculadora de hogar y agregador de finanzas."
>
  <header class="px-3 sm:px-4 lg:px-8 pt-4 sm:pt-5 lg:pt-6">
    <div class="mx-auto max-w-6xl">
      <a href={base} class="py-1 inline-flex items-center gap-1.5 text-sm font-semibold text-gray-600 transition-colors hover:text-gray-900">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        <span data-i18n="page.backHome"></span>
      </a>
    </div>
  </header>

  <div class="px-8 py-10 sm:py-14">
    <div class="mx-auto max-w-4xl">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight" data-i18n="page.guide.title"></h1>
      <p class="mt-3 leading-relaxed text-gray-500" data-i18n="page.guide.subtitle"></p>

      <div class="mt-10 flex flex-col gap-6">
        {sections.map((s) => (
          <section class="bg-[#fdfdfe] border border-gray-200 rounded-2xl p-5 sm:p-6">
            <div class="flex items-center gap-3">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-gray-900 text-white flex items-center justify-center"><Icon name={s.icon} className="w-5 h-5" /></span>
              <h2 class="text-lg font-bold text-gray-900 tracking-tight" data-i18n={s.titleKey}></h2>
            </div>
            <p class="mt-3 leading-relaxed text-gray-500" data-i18n={s.textKey}></p>
            <p class="mt-5 text-xs font-semibold uppercase tracking-widest text-gray-400" data-i18n="page.guide.howtoLabel"></p>
            <ol class="mt-3 space-y-2.5">
              {s.stepKeys.map((step, j) => (
                <li class="flex items-start gap-2.5">
                  <span class="flex-shrink-0 w-5 h-5 rounded-full bg-zinc-100 text-gray-700 text-[11px] font-bold flex items-center justify-center mt-0.5">{j + 1}</span>
                  <p class="leading-relaxed text-gray-600" data-i18n={step}></p>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    </div>
  </div>
</SimplePage>