---
import SimplePage from '../layouts/SimplePage.astro';

const base = import.meta.env.BASE_URL;
const faqs = [1, 2, 3, 4, 5, 6, 7];
---

<SimplePage
  dataTitle="page.faq.title"
  dataDescription="page.faq.metaDescription"
  description="Preguntas frecuentes sobre NestEgg: privacidad, bancos compatibles, copias de seguridad y más."
>
  <header class="px-3 sm:px-4 lg:px-8 pt-4 sm:pt-5 lg:pt-6">
    <div class="mx-auto max-w-6xl">
      <a href={base} class="py-1 inline-flex items-center gap-1.5 text-sm font-semibold text-gray-600 transition-colors hover:text-gray-900">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        <span data-i18n="page.backHome"></span>
      </a>
    </div>
  </header>

  <div class="px-8 py-10 sm:py-14">
    <div class="mx-auto max-w-4xl">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight" data-i18n="page.faq.title"></h1>
      <p class="mt-3 leading-relaxed text-gray-500" data-i18n="page.faq.subtitle"></p>

      <div class="mt-10 flex flex-col gap-3">
        {faqs.map(n => (
          <details class="group bg-[#fdfdfe] border border-gray-200 rounded-2xl p-5 open:shadow-sm">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm sm:text-base font-semibold text-gray-900">
              <span data-i18n={`page.faq.q${n}`}></span>
              <svg class="w-5 h-5 flex-shrink-0 text-gray-400 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            {n === 3 ? (
              <p class="mt-3 leading-relaxed text-gray-500">
                <span data-i18n="page.faq.a3_part1"></span>
                <a href={`${base}/bancos`} class="underline hover:no-underline transition-colors font-medium text-gray-500 hover:text-gray-600" data-i18n="page.faq.a3_link"></a>
                <span data-i18n="page.faq.a3_part2"></span>
              </p>
            ) : (
              <p class="mt-3 leading-relaxed text-gray-500" data-i18n={`page.faq.a${n}`}></p>
            )}
          </details>
        ))}
      </div>
    </div>
  </div>
</SimplePage>